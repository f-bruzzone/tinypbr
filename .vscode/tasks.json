{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cppbuild",
			"label": "build-debug",
			"command": "/usr/bin/clang++",
			"args": [
				"-fcolor-diagnostics",
				"-fansi-escape-codes",
				"-I${workspaceFolder}/Includes/**",
				"-g",
				"-O0",
				"${workspaceFolder}/**.cpp",
				"-std=c++20",
				"-o",
				"${workspaceFolder}/Build/app_debug"
			],
			"options": {
				"cwd": "${fileDirname}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"detail": "compiler: /usr/bin/clang++"
		},
		{
			"type": "cppbuild",
			"label": "build-release",
			"command": "/usr/bin/clang++",
			"args": [
				"-fcolor-diagnostics",
				"-fansi-escape-codes",
				"-I${workspaceFolder}/Includes/**",
				"-g",
				"-O3",
				"${workspaceFolder}/**.cpp",
				"-std=c++20",
				"-o",
				"${workspaceFolder}/Build/app_release"
			],
			"options": {
				"cwd": "${fileDirname}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"detail": "compiler: /usr/bin/clang++"
		}
	]
}